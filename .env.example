# Copy to .env, edit, then use any script (they load .env themselves).  For manual runs:
#     set -a; source .env; set +a
# (.env is git-ignored - never commit real passwords)

# ---- PostgreSQL (used by the Master and the ML tool only) --------------------------------
NEXUS_DB_HOST=localhost
NEXUS_DB_PORT=5432            # 54329 when you use ./setup/local_pg.sh (private rootless cluster)
NEXUS_DB_NAME=nexus
NEXUS_DB_USER=nexus
NEXUS_DB_PASSWORD=change_me   # choose your own; setup.sh creates the role with this password

# ---- Network ----------------------------------------------------------------------------
NEXUS_MASTER_HOST=127.0.0.1   # where Workers find the Master
NEXUS_MASTER_PORT=5050        # Worker <-> Master TCP port
NEXUS_HTTP_PORT=8080          # dashboard + REST API
NEXUS_HTTP_BIND=127.0.0.1     # 0.0.0.0 exposes the (unauthenticated!) API to the network

# ---- Cluster behaviour (optional) ----------------------------------------------------------
NEXUS_HEARTBEAT_SEC=3         # Worker heartbeat interval; a Worker is dead after 3 missed beats
NEXUS_QUIET_HEARTBEAT=1       # 0 = Master logs every heartbeat
NEXUS_SCHED_POLICY=           # FCFS | ROUND_ROBIN | PRIORITY | RESOURCE_AWARE | AI_ASSISTED (overrides the stored policy at start)

# ---- Worker (optional) -------------------------------------------------------------------
NEXUS_WORKER_CAPACITY=        # max tasks a Worker runs at once (default: its CPU cores)
NEXUS_WORKER_STORAGE=worker_data   # parent directory of <WORKER_ID>/blocks/
NEXUS_WORKER_RECONNECT=1      # keep reconnecting when the Master disappears

# ---- Distributed storage (optional) ----------------------------------------------------------
NEXUS_BLOCK_SIZE=262144       # default block size in bytes (16 .. 4194304)
NEXUS_REPLICATION=2           # default replication factor
NEXUS_MAX_UPLOAD_MB=64        # largest accepted upload (the file is held in memory while it is split)
NEXUS_EXPORT_DIR=exports      # where the Master console 'download' command writes reconstructed files

# ---- AI model (optional) -----------------------------------------------------------------------
NEXUS_ML_MODEL=               # empty = models/duration_xgb.model or models/duration_rf.model by model type
NEXUS_ML_MIN_SAMPLES=30       # fewer completed executions => INSUFFICIENT_DATA, no model is created
NEXUS_ML_TREES=60
NEXUS_ML_MAX_DEPTH=12

# ---- Multi-machine (Workers on OTHER computers) ---------------------------------------------------
# On the Master computer:   NEXUS_MASTER_BIND=0.0.0.0   (listen on every interface; default)
#                           open TCP port NEXUS_MASTER_PORT (5050) in the firewall; keep NEXUS_HTTP_BIND=127.0.0.1
# On each Worker computer:  NEXUS_MASTER_HOST=<LAN IP of the Master computer>   NEVER 127.0.0.1 there
#                           ./scripts/start_remote_worker.sh <UNIQUE_WORKER_ID> <MASTER_IP>
NEXUS_MASTER_BIND=0.0.0.0     # interface of the Worker TCP port (127.0.0.1 = this computer only)

# ---- Worker CPU allocation: three SEPARATE settings --------------------------------------------------
NEXUS_WORKER_CPU_AFFINITY=    # which logical CPUs the Worker process may use: none | auto | "2" | "0,2" | "1-3"
                              # (start_cluster.sh sets auto = one dedicated CPU per Worker when enough CPUs exist)
NEXUS_WORKER_INDEX=           # only for "auto": which allowed CPU to take (default: number at the end of the id, W3 -> 2)
NEXUS_WORKER_THREADS=         # executor thread-pool size (default: = capacity)
# NEXUS_WORKER_CAPACITY above = max tasks the Master may assign at once (default: number of pinned CPUs, else all CPUs)
NEXUS_CPU_MAP=                # start_cluster.sh only: explicit CPU per Worker, e.g. 2,4,6  (W1->2 W2->4 W3->6)

# ---- XGBoost model (optional overrides) ----------------------------------------------------------------
NEXUS_ML_MODEL_TYPE=xgboost   # xgboost | random_forest  (model trained by default / by auto-retrain)
NEXUS_ML_XGB_ROUNDS=150
NEXUS_ML_XGB_DEPTH=4
NEXUS_ML_XGB_ETA=0.1
NEXUS_ML_AUTO_RETRAIN_EVERY=100   # retrain in a background thread after this many new completed executions (0 = off)
